# Local open-source HydraDB (docker compose). Bolt password is the
# documented local-development token, not a cloud secret.
HYDRADB_BACKEND=bolt
HYDRADB_BOLT_URI=bolt://127.0.0.1:7687
HYDRADB_BOLT_USER=neo4j
HYDRADB_BOLT_PASSWORD=local-development-token-32-bytes
HYDRADB_BOLT_DATABASE=default

# Hosted HydraDB BYOG (https://api.hydradb.com). Leave the key empty until
# a paid workspace is available. The hosted adapter is unused when
# HYDRADB_BACKEND=bolt.
HYDRADB_URL=https://api.hydradb.com
HYDRADB_API_KEY=
HYDRADB_DATABASE=repocortex
HYDRADB_COLLECTION=code

# Reserved for a later generation step. Unused in phase 1.
GMI_API_KEY=

REPOCORTEX_DJANGO=data/django
REPOCORTEX_SCOPE=django,tests
REPOCORTEX_LIMIT=1600
REPOCORTEX_HOLDOUT=0.2
REPOCORTEX_HOPS=2
